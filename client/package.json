{
  "name": "loop-server",
  "version": "1.0.0",
  "description": "Realtime chat backend for the Loop app",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "tsc app.jsx --allowJs --jsx react --target es2020 --alwaysStrict --skipLibCheck --noEmitOnError --outDir ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.1.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^3.3.7",
    "socket.io": "^4.7.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18"
  }
}
