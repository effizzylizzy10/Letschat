# Copy these into Render > your service > Environment. Never commit real values.

# Firebase project that signs users in
FIREBASE_PROJECT_ID=letschatafrica-1df0c

# Long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=

# Creator/owner accounts (comma-separated). Needs a Firebase-VERIFIED email: gets the verified badge + creator tools
CREATOR_EMAILS=effizzylizzy10@gmail.com

# Optional: extra verified-badge users (ids, emails or phone numbers, comma-separated)
VERIFIED_USERS=

# Your deployed website address, so only it can call the server (leave * only while testing)
CLIENT_ORIGIN=https://your-site.netlify.app

# Database (without these, data is lost on every restart)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Push notifications: two independent channels (either works without the other) ----
# 1) Firebase Cloud Messaging (FCM): the Android app, the iOS app and Firebase-based browser push. Never uses VAPID keys.
#    FIREBASE_SERVICE_ACCOUNT = the service-account JSON, pasted as it is (or base64 of it).
#    Firebase console > Project settings > Service accounts > Generate new private key. Paste the WHOLE file into Render as ONE variable.
#    Never commit it and never put it in client code. Without it, Android / iOS pushes are off (the server logs "[fcm] FIREBASE_SERVICE_ACCOUNT is not set").
FIREBASE_SERVICE_ACCOUNT=
# 2) Classic browser Web Push (VAPID). Only for browsers that subscribe the old way. Generate once: npx web-push generate-vapid-keys
#    Keep the same keys for ever: changing them signs every browser out of push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional, Letschat Lite (plain pages for Opera Mini / keypad phones at /lite): email + password sign-in goes through Firebase.
# The defaults already match client/config.js. Set these only if your Firebase web key is restricted to a website.
FIREBASE_WEB_API_KEY=
LITE_REFERER=https://letschatafric.netlify.app/

# Letschat AI agent: free AI engine (OPTIONAL, set any ONE). Without a key the agent still answers from free online sources.
# Groq: free, no card (console.groq.com). Gemini: free (aistudio.google.com). OpenRouter: use a ":free" model.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Free-tier model names change, so they can be changed here without editing code:
# GROQ_MODEL=llama-3.1-8b-instant
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Any other OpenAI-compatible service: AI_API_KEY=, AI_BASE_URL=https://.../v1, AI_MODEL=
# Optional: extra news feeds (RSS, comma-separated) that the AI reads on its own every hour
# AI_FEEDS=https://feeds.bbci.co.uk/news/world/africa/rss.xml

# Free AI engines for the LetsChat AI robot (all optional; set as many as you like, they are tried in order and failed ones are skipped for a few minutes)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
TOGETHER_API_KEY=
HF_API_KEY=
SAMBANOVA_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
# Optional: real xAI Grok (console.x.ai). It is tried right after Gemini and Groq. Set XAI_MODEL if the default name changes.
XAI_API_KEY=
# Optional model overrides: GEMINI_MODEL, GROQ_MODEL, OPENROUTER_MODEL, TOGETHER_MODEL, HF_MODEL, SAMBANOVA_MODEL, CLOUDFLARE_MODEL

# LetsChat AI page (API only). Set any of these, they are tried in order: Gemini, OpenAI, Grok (xAI), Groq, DeepSeek, Mistral, OpenRouter, ...
# OPENAI_API_KEY=       (ChatGPT, default model gpt-4o-mini, change with OPENAI_MODEL)
# XAI_API_KEY=          (Grok, default model grok-4, change with XAI_MODEL)
# DEEPSEEK_API_KEY=     (DEEPSEEK_MODEL)      MISTRAL_API_KEY=   (MISTRAL_MODEL)
# AI_PRIMARY=openai     (optional: try this provider first: gemini, openai, xai, groq, deepseek, mistral, openrouter ...)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
AI_PRIMARY=

# YouTube search inside Letschat (attach menu > YouTube). Optional: without it everything else works, only the search sheet is hidden.
# Free key: console.cloud.google.com > create a project > APIs & Services > Library > "YouTube Data API v3" > Enable >
# Credentials > Create credentials > API key. Limit the key to "YouTube Data API v3" only. Do NOT limit it to websites or IP
# addresses: the server makes the calls. Google's free allowance is about 100 searches a day; trending lists and video details have
# a separate, much larger allowance. See YOUTUBE-LINKS-API.md.
YOUTUBE_API_KEY=
# Optional: two-letter country for Trending and search results (default NG) and safe search level: none, moderate (default) or strict
# YOUTUBE_REGION=NG
# YOUTUBE_SAFE_SEARCH=moderate
