# Copy these into Render > your service > Environment. Never commit real values.

# Firebase project that signs users in
FIREBASE_PROJECT_ID=letschatafrica-1df0c

# Long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=

# Creator/owner accounts (comma-separated). Needs a Firebase-VERIFIED email: gets the verified badge + creator tools
CREATOR_EMAILS=effizzylizzy10@gmail.com

# Optional: extra verified-badge users (ids, emails or phone numbers, comma-separated)
VERIFIED_USERS=

# Your deployed website address, so only it can call the server (leave * only while testing)
CLIENT_ORIGIN=https://your-site.netlify.app

# Database (without these, data is lost on every restart)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional push notifications (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional, Letschat Lite (plain pages for Opera Mini / keypad phones at /lite): email + password sign-in goes through Firebase.
# The defaults already match client/config.js. Set these only if your Firebase web key is restricted to a website.
FIREBASE_WEB_API_KEY=
LITE_REFERER=https://letschatafric.netlify.app/

# Letschat AI agent: free AI engine (OPTIONAL, set any ONE). Without a key the agent still answers from free online sources.
# Groq: free, no card (console.groq.com). Gemini: free (aistudio.google.com). OpenRouter: use a ":free" model.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Free-tier model names change, so they can be changed here without editing code:
# GROQ_MODEL=llama-3.1-8b-instant
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Any other OpenAI-compatible service: AI_API_KEY=, AI_BASE_URL=https://.../v1, AI_MODEL=
# Optional: extra news feeds (RSS, comma-separated) that the AI reads on its own every hour
# AI_FEEDS=https://feeds.bbci.co.uk/news/world/africa/rss.xml

# Free AI engines for the LetsChat AI robot (all optional; set as many as you like, they are tried in order and failed ones are skipped for a few minutes)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
TOGETHER_API_KEY=
HF_API_KEY=
SAMBANOVA_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
# Optional: real xAI Grok (console.x.ai). It is tried right after Gemini and Groq. Set XAI_MODEL if the default name changes.
XAI_API_KEY=
# Optional model overrides: GEMINI_MODEL, GROQ_MODEL, OPENROUTER_MODEL, TOGETHER_MODEL, HF_MODEL, SAMBANOVA_MODEL, CLOUDFLARE_MODEL
